APP_ENV=prod
APP_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=bahdan_toolbox
POSTGRES_USER=bahdan
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AUDIT_MAX_PAGES=40
AUDIT_CONCURRENCY=3
