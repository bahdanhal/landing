{% extends 'base.html.twig' %}
{% block tool_name %}{{ 'base.context.geo'|trans }}{% endblock %}
{% block title %}{{ 'geo.report.title'|trans }} · {{ report.final_url }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/tools.css"><link rel="stylesheet" href="/geo.css">{% endblock %}
{% block language_switch %}<a class="language-switch" href="{{ path('geo_home', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>{% endblock %}

{% block body %}
    <section class="report-shell geo-report">
        <div class="report-head">
            <div>
                <a class="back" href="{{ path('geo_home', {_locale: app.request.locale}) }}">← {{ 'geo.report.new'|trans }}</a>
                <div class="eyebrow">{{ report.cache.hit ? 'geo.report.cached'|trans : 'geo.report.complete'|trans }} · {{ report.duration_ms }} MS</div>
                <h1>{{ report.final_url }}</h1>
                <p>{{ 'geo.report.generated'|trans }} {{ report.generated_at|date(app.request.locale == 'pl' ? 'd.m.Y H:i' : 'M j, Y H:i') }} UTC</p>
                <form class="refresh-form" method="post" action="{{ path('geo_audit') }}"><input type="hidden" name="url" value="{{ report.target }}"><input type="hidden" name="refresh" value="1"><button type="submit">{{ 'geo.report.refresh'|trans }}</button></form>
            </div>
            <div class="score score-{{ report.score >= 80 ? 'good' : (report.score >= 55 ? 'fair' : 'poor') }}"><strong>{{ report.score }}</strong><span>/100</span><small>{{ 'geo.report.score'|trans }}</small></div>
        </div>

        <div class="metrics geo-metrics">
            <div><strong>{{ report.counts.pass }}</strong><span>{{ 'geo.report.passed'|trans }}</span></div>
            <div><strong>{{ report.counts.warning }}</strong><span>{{ 'geo.report.partial'|trans }}</span></div>
            <div><strong>{{ report.counts.fail }}</strong><span>{{ 'geo.report.failed'|trans }}</span></div>
            <div><strong>{{ report.page.schema_types|length }}</strong><span>{{ 'geo.report.schema_types'|trans }}</span></div>
        </div>

        <section class="section">
            <div class="section-title"><h2>{{ 'geo.report.checks'|trans }}</h2><span>{{ 'geo.report.explain'|trans }}</span></div>
            <div class="geo-checks">
                {% for check in report.checks %}
                    <details class="geo-check geo-check-{{ check.status }}" {{ check.status != 'pass' ? 'open' : '' }}>
                        <summary><span class="check-state">{{ ('geo.status.' ~ check.status)|trans }}</span><strong>{{ ('geo.check.' ~ check.id ~ '.title')|trans }}</strong><span class="check-points">{{ check.earned }}/{{ check.maximum }}</span></summary>
                        <div class="geo-check-body"><p>{{ ('geo.check.' ~ check.id ~ '.help')|trans }}</p><pre>{{ check.evidence|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></div>
                    </details>
                {% endfor %}
            </div>
        </section>

        <section class="section crawler-policy">
            <div class="section-title"><h2>{{ 'geo.crawlers.title'|trans }}</h2><span>{{ 'geo.crawlers.not_scored'|trans }}</span></div>
            <p>{{ 'geo.crawlers.intro'|trans }}</p>
            <div class="crawler-grid">
                {% for agent, policy in report.crawler_controls.policies %}<div><strong>{{ agent }}</strong><span class="policy policy-{{ policy }}">{{ ('geo.crawlers.' ~ policy)|trans }}</span></div>{% endfor %}
                <div><strong>llms.txt</strong><span class="policy">{{ report.crawler_controls.llms_txt_present ? 'geo.crawlers.present'|trans : 'geo.crawlers.absent'|trans }}</span></div>
            </div>
            <p class="legal-note">{{ 'geo.crawlers.caveat'|trans }}</p>
        </section>

        <section class="section content-card geo-next">
            <h2>{{ 'geo.next.title'|trans }}</h2><ol><li>{{ 'geo.next.one'|trans }}</li><li>{{ 'geo.next.two'|trans }}</li><li>{{ 'geo.next.three'|trans }}</li></ol>
        </section>
    </section>
{% endblock %}
