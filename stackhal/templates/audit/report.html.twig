{% extends 'base.html.twig' %}
{% block tool_name %}{{ 'base.context.seo'|trans }}{% endblock %}
{% block title %}{{ 'audit.report.title'|trans }} · {{ report.origin }}{% endblock %}
{% block language_switch %}<a class="language-switch" href="{{ path('seo_audit_home', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>{% endblock %}

{% block body %}
<section class="report-shell">
  <div class="report-head">
    <div>
      <a class="back" href="{{ path('seo_audit_home') }}">← {{ 'audit.report.new'|trans }}</a>
      <div class="eyebrow">{{ report.cache.hit ? 'audit.report.cached'|trans : 'audit.report.complete'|trans }} · {{ report.duration_ms }} MS</div>
      <h1>{{ report.origin }}</h1>
      <p>{{ 'audit.report.generated'|trans }} {{ report.generated_at|date(app.request.locale == 'pl' ? 'd.m.Y H:i' : 'M j, Y H:i') }} UTC</p>
      <form class="refresh-form" method="post" action="{{ path('audit') }}">
        <input type="hidden" name="url" value="{{ report.target }}">
        <input type="hidden" name="refresh" value="1">
        <button type="submit">{{ 'audit.report.refresh'|trans }}</button>
      </form>
    </div>
    <div class="score score-{{ report.score >= 80 ? 'good' : (report.score >= 55 ? 'fair' : 'poor') }}">
      <strong>{{ report.score }}</strong><span>/100</span><small>{{ 'audit.report.score'|trans }}</small>
    </div>
  </div>

  <div class="metrics">
    <div><strong>{{ report.summary.pages_crawled }}</strong><span>{{ 'audit.report.pages'|trans }}</span></div>
    <div><strong>{{ report.summary.urls_discovered }}</strong><span>{{ 'audit.report.urls'|trans }}</span></div>
    <div><strong>{{ report.summary.sitemap_urls }}</strong><span>{{ 'audit.report.sitemap_urls'|trans }}</span></div>
    <div><strong>{{ report.counts.critical }}</strong><span>{{ 'audit.report.critical'|trans }}</span></div>
    <div><strong>{{ report.counts.warning }}</strong><span>{{ 'audit.report.warnings'|trans }}</span></div>
  </div>

  {% if report.summary.crawl_truncated %}<div class="notice">{{ 'audit.report.truncated'|trans }}</div>{% endif %}

  {% if report.ai_summary and app.request.locale == 'en' %}
  <section class="section ai-summary">
    <div class="section-title"><h2>{{ 'audit.report.executive'|trans }}</h2><span>{{ 'audit.report.ai_note'|trans }}</span></div>
    <p class="ai-overview">{{ report.ai_summary.overview }}</p>
    {% if report.ai_summary.priorities is not empty %}
    <div class="priority-grid">
      {% for priority in report.ai_summary.priorities %}
      <article><b>{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</b><h3>{{ priority.title }}</h3><p>{{ priority.why }}</p><strong>Next: {{ priority.action }}</strong></article>
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <section class="section">
    <div class="section-title"><h2>{{ 'audit.report.findings'|trans }}</h2><span>{{ issueGroups|length }} {{ 'audit.report.finding_types'|trans }}</span></div>
    {% if report.issues is empty %}
      <div class="empty">{{ 'audit.report.empty'|trans }}</div>
    {% else %}
      <div class="issues">
      {% for group in issueGroups %}
        <details class="issue severity-{{ group.severity }}" {{ loop.index <= 6 ? 'open' : '' }}>
          <summary>
            <span class="pill">{{ group.severity }}</span>
            <strong>{{ ('audit.issues.' ~ group.code)|trans }}</strong>
            {% if group.occurrences|length > 1 %}<span class="finding-count">{{ group.occurrences|length }}</span>{% endif %}
            <code>{{ group.code }}</code>
          </summary>
          <div class="issue-body">
            {% if group.occurrences|length > 1 %}<p class="group-intro">{{ 'audit.report.found_in'|trans({'%count%': group.occurrences|length}) }}</p>{% endif %}
            <div class="occurrences">
            {% for occurrence in group.occurrences %}
              <details class="occurrence" {{ group.occurrences|length == 1 ? 'open' : '' }}>
                <summary><b>#{{ loop.index }}</b><span>{{ occurrence.detail }}</span></summary>
                {% if occurrence.evidence is not empty %}<pre>{{ occurrence.evidence|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>{% endif %}
              </details>
            {% endfor %}
            </div>
          </div>
        </details>
      {% endfor %}
      </div>
    {% endif %}
  </section>

  <section class="section editorial-review">
    <div class="section-title">
      <h2>{{ 'audit.report.editorial_review'|trans }}</h2>
      <span>{{ 'audit.report.not_scored'|trans }}</span>
    </div>
    <p>{{ 'audit.report.editorial_intro'|trans }}</p>
    <div class="priority-grid">
      {% for advisory in report.editorial_advisories %}
        <article>
          <b>{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</b>
          <h3>{{ ('audit.advisories.' ~ advisory.code ~ '.title')|trans }}</h3>
          <p>{{ ('audit.advisories.' ~ advisory.code ~ '.text')|trans }}</p>
        </article>
      {% endfor %}
    </div>
    <p><a href="https://developers.google.com/search/docs/fundamentals/creating-helpful-content" rel="noopener noreferrer">{{ 'audit.report.people_first_source'|trans }} ↗</a></p>
  </section>

  <section class="section">
    <div class="section-title"><h2>{{ 'audit.report.redirect_matrix'|trans }}</h2><span>{{ report.redirect_matrix|length }} {{ 'audit.report.variants'|trans }}</span></div>
    <div class="table-wrap"><table><thead><tr><th>Requested</th><th>Status</th><th>Hops</th><th>Final URL</th><th>Time</th></tr></thead><tbody>
    {% for item in report.redirect_matrix %}<tr><td class="url">{{ item.requested_url }}</td><td><span class="status status-{{ item.status >= 400 or item.status == 0 ? 'bad' : 'good' }}">{{ item.status ?: 'ERR' }}</span></td><td>{{ item.redirects|length }}</td><td class="url">{{ item.final_url }}</td><td>{{ item.duration_ms }} ms</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="section">
    <div class="section-title"><h2>{{ 'audit.report.crawled_pages'|trans }}</h2><span>{{ report.pages|length }} {{ 'audit.report.sampled'|trans }}</span></div>
    <div class="table-wrap"><table><thead><tr><th>URL</th><th>Status</th><th>Canonical</th><th>Title</th><th>H1</th><th>Words</th></tr></thead><tbody>
    {% for page in report.pages %}<tr><td class="url">{{ page.final_url }}</td><td><span class="status status-{{ page.status >= 400 or page.status == 0 ? 'bad' : 'good' }}">{{ page.status ?: 'ERR' }}</span></td><td>{{ page.canonical ? (page.canonical == page.final_url ? 'Self' : 'Other') : 'Missing' }}</td><td>{{ page.title|default('—') }}</td><td>{{ page.h1|length }}</td><td>{{ page.word_count }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>

  <section class="section split">
    <div><div class="section-title"><h2>robots.txt</h2></div><div class="code-card"><b>HTTP {{ report.robots.status }}</b><pre>{{ report.robots.body ?: 'audit.report.no_robots'|trans }}</pre></div></div>
    <div><div class="section-title"><h2>{{ 'audit.report.sitemaps'|trans }}</h2></div><div class="code-card"><b>{{ 'audit.report.sitemap_summary'|trans({'%urls%': report.sitemap.url_count, '%files%': report.sitemap.files|length}) }}</b><ul>{% for file in report.sitemap.files %}<li><span>{{ file.status }}</span> {{ file.url }}</li>{% else %}<li>{{ 'audit.report.no_sitemap'|trans }}</li>{% endfor %}</ul></div></div>
  </section>

</section>
{% endblock %}
