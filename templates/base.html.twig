{% set tool_context %}{% block tool_name %}{% endblock %}{% endset %}
<!doctype html>
<html lang="{{ app.request ? app.request.getLocale() : 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta property="og:site_name" content="{{ 'base.brand'|trans }}">
  <meta property="og:type" content="website">
  {% block robots %}<meta name="robots" content="noindex,nofollow">{% endblock %}
  {% block description %}{% endblock %}
  {% block canonical %}{% endblock %}
  <title>{% block title %}{{ 'base.default_title'|trans }}{% endblock %}</title>
  {% block opengraph %}
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:locale" content="{{ app.request ? (app.request.locale == 'pl' ? 'pl_PL' : 'en_US') : 'en_US' }}">
    <meta property="og:locale:alternate" content="{{ app.request ? (app.request.locale == 'pl' ? 'en_US' : 'pl_PL') : 'pl_PL' }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
  {% endblock %}
  <meta name="theme-color" content="#fafafa">
  <link rel="icon" href="/favicon.svg?v=3" sizes="any" type="image/svg+xml">
  <link rel="shortcut icon" href="/favicon.svg?v=3" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg?v=3">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt">
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt">
  {% block shared_stylesheets %}
  <link rel="stylesheet" href="/app.css?v=2">
  <link rel="stylesheet" href="/contact.css">
  <link rel="stylesheet" href="/identity.css">
  <link rel="stylesheet" href="/ui.css">
  {% endblock %}
  {% block stylesheets %}{% endblock %}
  {% block brand_stylesheet %}<link rel="stylesheet" href="/brand-refresh.css">{% endblock %}
  {% block final_stylesheets %}{% endblock %}
  <link rel="stylesheet" href="/contact-details.css?v=1">
  <script src="/contact.js" defer></script>
  <script type="application/ld+json">{{ {'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':'https://bahdanhal.pl/#website','url':'https://bahdanhal.pl/','name':'Bahdan Hal','inLanguage':['en','pl'],'publisher':{'@id':'https://bahdanhal.pl/#bahdan'},'author':{'@id':'https://bahdanhal.pl/#bahdan'},'dateModified':'2026-08-22'},{'@type':'Person','@id':'https://bahdanhal.pl/#bahdan','name':'Bahdan Hal','url':'https://bahdanhal.pl/','jobTitle':'Backend Engineer','email':portfolio_email,'sameAs':['https://www.linkedin.com/in/bahdan-hal/','https://github.com/bahdanhal','https://www.instagram.com/bahdan.hal/','https://www.facebook.com/profile.php?id=100008404566585','https://www.upwork.com/freelancers/~014111a2d384da6af9']}]}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
  {% block head_scripts %}{% endblock %}
</head>
{% set current_route = app.request ? (app.request.attributes.get('_route') ?: 'landing') : 'landing' %}
{% set target_route = current_route in ['landing', 'resume', 'services'] ? current_route : 'landing' %}
{% set target_locale = app.request and app.request.locale == 'pl' ? 'en' : 'pl' %}
<body class="portfolio-site {% block body_class %}{% endblock %}" {% block body_attributes %}{% endblock %}>
  <header class="site-header">
    <div class="topbar">
      <div class="brand-lockup">
        {% block brand_lockup %}
        <a class="brand" href="{{ path('landing', {_locale: app.request ? app.request.locale : 'en'}) }}" aria-label="{{ 'base.home_label'|trans }}">
          <span class="brand-mark">BH</span>
          <span class="brand-name"><span class="brand-name-full">{{ 'base.brand'|trans }}</span><span class="brand-name-short">{{ 'base.brand_short'|trans }}</span></span>
        </a>
        <span class="brand-credit">{{ 'about.role_short'|trans }}</span>
        {% endblock %}
      </div>
      <div class="topbar-actions">
        <nav class="primary-nav" aria-label="{{ 'base.navigation'|trans }}">
          <a href="{{ path('landing', {_locale: app.request ? app.request.locale : 'en'}) }}" class="{{ current_route == 'landing' ? 'active' : '' }}">{{ 'base.nav.about'|trans }}</a>
          <a href="{{ path('resume', {_locale: app.request ? app.request.locale : 'en'}) }}" class="{{ current_route == 'resume' ? 'active' : '' }}">{{ 'base.nav.resume'|trans }}</a>
          <a href="{{ path('services', {_locale: app.request ? app.request.locale : 'en'}) }}" class="{{ current_route == 'services' ? 'active' : '' }}">{{ 'base.nav.services'|trans }}</a>
          <a href="{{ path(target_route, {_locale: app.request ? app.request.locale : 'en'}) }}#contact">{{ 'base.contact'|trans }}</a>
        </nav>
        {% block language_switch %}
          <a class="language-switch" href="{{ path(target_route, {_locale: target_locale}) }}" hreflang="{{ target_locale }}">{{ app.request and app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
        {% endblock %}
      </div>
    </div>
  </header>
  {% if site_content_preview() %}
    <aside style="position:sticky;top:0;z-index:100;background:#fff1bf;color:#322a13;padding:12px 20px;text-align:center;font:14px/1.5 Arial,sans-serif;">
      <strong>Draft preview</strong> · Visitors still see the published version.
      <a href="{{ path('portfolio_admin_content') }}" style="text-decoration:underline;color:inherit;">Back to editor</a>
    </aside>
  {% endif %}
  <main>{% block body %}{% endblock %}</main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="site-footer-identity"><strong>Bahdan Hal</strong><span>{{ 'base.footer_role'|trans }}</span></div>
      <nav aria-label="{{ 'base.footer_navigation'|trans }}">
        <a href="{{ path('resume', {_locale: app.request ? app.request.locale : 'en'}) }}">{{ 'base.resume'|trans }}</a>
        <a href="{{ path('services', {_locale: app.request ? app.request.locale : 'en'}) }}">{{ 'base.nav.services'|trans }}</a>
        <a href="/resume.pdf" download>{{ 'resume_page.download_pdf'|trans }}</a>
        <a href="mailto:{{ portfolio_email }}">{{ 'base.contact'|trans }}</a>
        <a href="https://www.linkedin.com/in/bahdan-hal/" rel="me">LinkedIn</a>
        <a href="https://github.com/bahdanhal" rel="me">GitHub</a>
        {% for project in site_content().projects %}<a href="{{ project.url }}" rel="me">{{ project.name }}</a>{% endfor %}
      </nav>
    </div>
    <div class="copyright">© {{ "now"|date("Y") }} · {{ 'base.footer_note'|trans }}</div>
  </footer>
  {% block scripts %}{% endblock %}
  <script>
    (function(){
      if(location.pathname.startsWith('/admin')||new URLSearchParams(location.search).has('_content_preview')||navigator.doNotTrack==='1'||window.doNotTrack==='1'||navigator.globalPrivacyControl)return;
      var d=JSON.stringify({p:location.pathname,r:document.referrer||null,s:new URLSearchParams(location.search).get('utm_source')});
      if(navigator.sendBeacon){navigator.sendBeacon('/api/pa/hit',new Blob([d],{type:'application/json'}));}
      else{fetch('/api/pa/hit',{method:'POST',body:d,headers:{'Content-Type':'application/json'},keepalive:true});}
    })();
  </script>
</body>
</html>
