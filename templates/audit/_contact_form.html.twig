<form class="lead-form" method="post" action="{{ path('contact') }}" data-contact-form>
  <label for="contact-email-{{ source }}">Your email</label>
  <div class="lead-row">
    <input id="contact-email-{{ source }}" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required>
    <button type="submit">Ask Bahdan</button>
  </div>
  <input type="hidden" name="source" value="{{ source }}">
  <label class="lead-trap" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off"></label>
  <small>Stored privately on this server so Bahdan can follow up. No mailing list.</small>
  <p class="lead-status" data-contact-status aria-live="polite"></p>
</form>
