{% extends 'base.html.twig' %}
{% block tool_name %}Portfolio Admin{% endblock %}
{% block title %}Portfolio Admin Login · Bahdan Hal{% endblock %}
{% block robots %}<meta name="robots" content="noindex,nofollow">{% endblock %}
{% block body %}
    <section class="section" style="max-width: 520px; margin: 60px auto 100px; padding: 0 20px;">
        <div style="background: var(--panel, #ffffff); border: 1px solid var(--line, #e2ded4); border-radius: 16px; padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
            <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent, #d9532f); margin-bottom: 8px;">ADMINISTRATIVE ACCESS</div>
            <h1 style="font-size: 26px; font-weight: 800; margin: 0 0 12px; color: var(--ink, #1f1d1a);">Portfolio <em style="font-style: normal; color: var(--accent, #d9532f);">Admin</em></h1>
            <p style="font-size: 14px; line-height: 1.5; color: var(--muted, #68645d); margin: 0 0 24px;">Enter your admin token or passphrase to view consultation leads and traffic analytics.</p>

            {% if error is defined and error %}
                <div style="background: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; color: #dc3545; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; font-weight: 700;">
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('portfolio_admin_login') }}" style="display: flex; flex-direction: column; gap: 16px;">
                <input type="hidden" name="_token" value="{{ admin_csrf_token('portfolio_admin_login') }}">
                <div>
                    <label for="admin-password" style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 8px; color: var(--ink, #1f1d1a);">Admin Token / Passphrase</label>
                    <input id="admin-password" name="password" type="password" required autofocus placeholder="Enter ADMIN_TOKEN or APP_SECRET" style="width: 100%; box-sizing: border-box; padding: 12px 14px; border: 1px solid var(--line, #e2ded4); border-radius: 8px; font: inherit; font-size: 14px; background: #fff;">
                </div>
                <button type="submit" style="background: var(--ink, #1f1d1a); color: #fff; border: 0; padding: 12px 20px; font-weight: 700; font-size: 14px; border-radius: 8px; cursor: pointer; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">Sign In</button>
            </form>
        </div>
    </section>
{% endblock %}
