<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Website content · Bahdan Hal</title>
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml">
    <link rel="stylesheet" href="/content-editor.css?v=9">
    <script src="/content-editor.js?v=9" defer></script>
</head>
<body>
    <header class="ed-top">
        <a class="ed-back" href="{{ path('portfolio_admin_dashboard') }}" aria-label="Back to dashboard">←</a>
        <div class="ed-brand"><strong>Website content</strong><span id="ed-status" class="ed-status" role="status">Loading…</span></div>
        <div class="ed-actions">
            <div class="ed-preview">
                <button type="button" class="ed-btn ed-btn-ghost" id="ed-preview-toggle" aria-haspopup="true" aria-expanded="false">Preview<span class="ed-wide" aria-hidden="true">&nbsp;↗</span></button>
                <div class="ed-menu" id="ed-preview-menu" hidden></div>
            </div>
            <button type="button" class="ed-btn ed-btn-ghost" id="ed-discard"><span class="ed-wide">Discard draft</span><span class="ed-narrow">Discard</span></button>
            <button type="button" class="ed-btn" id="ed-save" title="Save draft (⌘S)"><span class="ed-wide">Save draft</span><span class="ed-narrow">Save</span></button>
            <button type="button" class="ed-btn ed-btn-primary" id="ed-publish">Publish</button>
        </div>
    </header>
    <div class="ed-layout">
        <nav class="ed-nav" id="ed-nav" aria-label="Content sections"></nav>
        <main class="ed-main" id="ed-main" tabindex="-1"></main>
    </div>
    <div class="ed-toasts" id="ed-toasts" aria-live="polite"></div>
    <noscript><p class="ed-noscript">The content editor needs JavaScript.</p></noscript>
    <script type="application/json" id="ed-boot">{{ boot|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
</body>
</html>
