{% extends 'base.html.twig' %}
{% block body_class %}portfolio-page about-page showcase-page{% endblock %}
{% block body_attributes %}data-concept="showcase"{% endblock %}
{% block final_stylesheets %}<link rel="stylesheet" href="/showcase.css?v=6"><script src="/showcase.js?v=1" defer></script>{% endblock %}
{% block title %}{{ 'about.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'about.meta.description'|trans }}">{% endblock %}
{% block canonical %}
    <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/' : 'https://bahdanhal.pl/' }}">
    <link rel="alternate" hreflang="en" href="https://bahdanhal.pl/">
    <link rel="alternate" hreflang="pl" href="https://bahdanhal.pl/pl/">
    <link rel="alternate" hreflang="x-default" href="https://bahdanhal.pl/">
{% endblock %}
{% block shared_stylesheets %}{% endblock %}
{% block stylesheets %}{% endblock %}
{% block brand_stylesheet %}{% endblock %}
{% block head_scripts %}
  <script type="application/ld+json">{{ {'@context':'https://schema.org','@graph':[{'@type':'Person','@id':'https://bahdanhal.pl/#bahdan','name':'Bahdan Hal','url':'https://bahdanhal.pl/','jobTitle':'Senior Backend & Systems Engineer','email':portfolio_email,'sameAs':['https://www.linkedin.com/in/bahdan-hal/','https://github.com/bahdanhal','https://www.instagram.com/bahdan.hal/','https://www.facebook.com/profile.php?id=100008404566585','https://www.upwork.com/freelancers/~014111a2d384da6af9']},{'@type':'WebApplication','@id':'https://stackhal.com/#app','name':'StackHal Developer Utilities Suite','url':'https://stackhal.com/','applicationCategory':'DeveloperApplication','operatingSystem':'All','author':{'@id':'https://bahdanhal.pl/#bahdan'}},{'@type':'WebApplication','@id':'https://ileza.pl/#app','name':'IleZa.pl Editorial Fair Prices','url':'https://ileza.pl/','applicationCategory':'FinanceApplication','operatingSystem':'All','author':{'@id':'https://bahdanhal.pl/#bahdan'}}]}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body %}
    <div class="workspace"><article class="profile-shell" id="overview" data-enlarge-label="{{ 'showcase.enlarge'|trans }}" data-close-label="{{ 'showcase.close'|trans }}" data-top-label="{{ 'showcase.back_top'|trans }}">
        <section class="profile-hero">
            <div class="profile-hero-media">
                <img src="/images/profile/bahdan-portrait.jpg" alt="Bahdan Hal" width="480" height="560" class="profile-avatar">
            </div><div class="profile-hero-content">
                <div class="eyebrow">{{ 'about.eyebrow'|trans }}</div>
                <h1>{{ 'about.heading'|trans }}</h1>
                <div class="profile-intro">
                    <p>{{ 'about.intro'|trans }}</p>
                    <div class="profile-actions">
                        <a class="profile-primary" href="{{ path('resume', {_locale: app.request.locale}) }}">{{ 'about.cta_resume'|trans }}</a>
                        <a class="profile-secondary" href="{{ path('services', {_locale: app.request.locale}) }}">{{ 'about.cta_services'|trans }}</a>
                        <a class="profile-tertiary" href="#contact">{{ 'about.cta_contact'|trans }} →</a>
                    </div>
                </div>
            </div>

        </section>

        <section class="profile-facts" aria-label="{{ 'about.facts_label'|trans }}">
            {% for fact in site_content().facts %}<span>{{ fact.text }}</span>{% endfor %}
        </section>

        <section class="ai-dump" id="ai-notes">
            <details>
                <summary>
                    <span class="ai-dump-heading"><span class="eyebrow">{{ 'about.ai_dump.label'|trans }}</span><strong>{{ 'about.ai_dump.title'|trans }}</strong></span>
                </summary>
                <div class="ai-dump-body">
                    <p class="ai-dump-intro">{{ 'about.ai_dump.intro'|trans }}</p>
                    <h3>{{ 'about.ai_dump.activity_title'|trans }}</h3>
                    <dl>
                        {% for tool in site_content().ai_activity %}
                            <dt>{{ tool.title }}</dt>
                            <dd>{{ tool.text }}</dd>
                        {% endfor %}
                    </dl>
                    {% for group in ['ideas', 'approach'] %}
                        <h3>{{ ('about.ai_dump.' ~ group ~ '_title')|trans }}</h3>
                        <ul>
                            {% for note in attribute(site_content(), 'ai_' ~ group) %}
                                <li><strong>{{ note.title }}</strong> {{ note.text }}</li>
                            {% endfor %}
                        </ul>
                    {% endfor %}
                </div>
            </details>
        </section>

        <section class="obd-feature" id="obd">
            <div class="obd-copy">
                <span class="eyebrow">OBD Vault</span>
                <h2>{{ 'showcase.obd.description'|trans }}</h2>
                <p>{{ 'showcase.obd.details'|trans }}</p>
                <nav class="obd-links" aria-label="{{ 'showcase.obd.links'|trans }}">
                    <a class="obd-store-link" href="{{ 'links.obd_app_store'|trans }}" target="_blank" rel="noopener" aria-label="{{ 'showcase.obd.app_store'|trans }}">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M17.05 12.54c.03 3.19 2.8 4.25 2.83 4.27-.02.07-.44 1.52-1.46 3.02-.89 1.3-1.81 2.59-3.26 2.62-1.42.03-1.88-.85-3.51-.85-1.62 0-2.13.82-3.48.88-1.4.05-2.46-1.4-3.36-2.69-1.83-2.65-3.23-7.49-1.35-10.75.94-1.62 2.61-2.65 4.42-2.68 1.38-.03 2.68.93 3.51.93.84 0 2.4-1.15 4.05-.98.69.03 2.63.28 3.87 2.1-.1.06-2.31 1.34-2.26 4.13ZM14.38 4.55c.75-.91 1.26-2.18 1.12-3.44-1.08.04-2.39.72-3.17 1.63-.69.8-1.3 2.08-1.14 3.3 1.21.09 2.44-.61 3.19-1.49Z"/></svg>
                        <span><small>{{ 'showcase.obd.download'|trans }}</small><strong>App Store</strong></span>
                    </a>
                    <a class="obd-store-link" href="{{ 'links.obd_google_play'|trans }}" target="_blank" rel="noopener" aria-label="{{ 'showcase.obd.google_play'|trans }}">
                        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="m3 2 11 10L3 22V2Zm12.5 8.6L5.3 1.3l13 7.5-2.8 1.8Zm0 2.8 2.8 1.8-13 7.5 10.2-9.3Zm1.5-1.4 3.3-2c1-.6 1.7-.2 1.7 1v2c0 1.2-.7 1.6-1.7 1L17 12Z"/></svg>
                        <span><small>{{ 'showcase.obd.download'|trans }}</small><strong>Google Play</strong></span>
                    </a>
                    <a class="obd-website-link" href="{{ 'links.obd_website'|trans }}" target="_blank" rel="noopener">obd-vault.com <span aria-hidden="true">↗</span></a>
                </nav>
                <div class="obd-switch" role="group" aria-label="{{ 'showcase.obd.screenshots'|trans }}">
                    <button type="button" aria-pressed="true" data-obd="/images/projects/obd-telemetry.jpg">{{ 'showcase.obd.telemetry'|trans }}</button>
                    <button type="button" aria-pressed="false" data-obd="/images/projects/obd-diagnostics.jpg">{{ 'showcase.obd.diagnostics'|trans }}</button>
                </div>
            </div>
            <div class="obd-screen">
                <img src="/images/projects/obd-telemetry.jpg" alt="{{ 'showcase.obd.telemetry'|trans }}" width="1290" height="2796" loading="lazy">
                <img class="obd-secondary-screen" src="/images/projects/obd-diagnostics.jpg" alt="{{ 'showcase.obd.diagnostics'|trans }}" width="1290" height="2796" loading="lazy">
            </div>
        </section>
        <section class="professional-experience" id="experience">
            <div class="profile-section-title"><h2>{{ 'resume_page.experience_title'|trans }}</h2></div>
            <div class="experience-list">{% include 'portfolio/_professional_experience.html.twig' %}</div>
        </section>
        <section class="about-story-section" id="story">
            <div class="profile-section-title">
                <span>{{ 'about.story.eyebrow'|trans }}</span>
                <h2>{{ 'about.story.title'|trans }}</h2>
            </div>
            <div class="about-story-content">
                <p class="story-lead">{{ 'about.story.p1'|trans }}</p>
            </div>
        </section>

        <section class="profile-projects" id="projects" aria-labelledby="projects-title">
            <div class="profile-section-title">
                <span>{{ 'about.ecosystem.eyebrow'|trans }}</span>
                <h2 id="projects-title">{{ 'about.ecosystem.title'|trans }}</h2>
                <p>{{ 'about.ecosystem.intro'|trans }}</p>
            </div>
            <div class="profile-project-grid">
                {% for project in site_content().projects %}
                    <article class="profile-project-card">
                        <a href="{{ project.url }}" target="_blank" rel="noopener" class="profile-project-image-link">
                            <img src="{{ project.image }}" alt="{{ project.image_alt }}" loading="lazy" width="1280" height="720">
                        </a>
                        <div class="profile-project-content">
                            <div class="profile-project-meta"><span>{{ project.name }}</span><span>{{ project.label }}</span></div>
                            <h3>{{ project.title }}</h3>
                            <p>{{ project.text }}</p>
                            <a href="{{ project.url }}" target="_blank" rel="noopener" class="profile-project-link">{{ 'about.ecosystem.visit'|trans }} →</a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>

        <figure class="profile-summit-feature">
            <div class="summit-image-wrap">
                <img src="/images/profile/bahdan-summit.jpg" alt="{{ 'about.summit.alt'|trans }}" loading="lazy">
            </div>
            <figcaption>
                <h3>{{ 'about.summit.caption'|trans }}</h3>
            </figcaption>
        </figure>

        <section class="about-gateways">
            <div class="profile-section-title">
                <span>{{ 'about.gateways.eyebrow'|trans }}</span>
                <h2>{{ 'about.gateways.title'|trans }}</h2>
            </div>
            <div class="gateway-grid">
                <article class="gateway-card">
                    <h3>{{ 'about.gateways.resume_title'|trans }}</h3>
                    <p>{{ 'about.gateways.resume_text'|trans }}</p>
                    <a href="{{ path('resume', {_locale: app.request.locale}) }}" class="gateway-cta">{{ 'about.gateways.resume_cta'|trans }}</a>
                </article>
                <article class="gateway-card gateway-card-highlight">
                    <h3>{{ 'about.gateways.services_title'|trans }}</h3>
                    <p>{{ 'about.gateways.services_text'|trans }}</p>
                    <a href="{{ path('services', {_locale: app.request.locale}) }}" class="gateway-cta">{{ 'about.gateways.services_cta'|trans }}</a>
                </article>
            </div>
        </section>

        <section class="contact-section" id="contact" aria-labelledby="contact-heading">
            <div class="contact-section-heading">
                <span class="eyebrow">{{ 'about.contact_eyebrow'|trans }}</span>
                <h2 id="contact-heading">{{ 'about.contact_heading'|trans }}</h2>
                <p>{{ 'contact.intro'|trans }}</p>
            </div>
            <div class="contact-section-grid">
                <div>
                    {% include 'portfolio/_contact_details.html.twig' %}
                </div>
                <div class="contact-form-panel">
                    <h3>{{ 'contact.form_heading'|trans }}</h3>
                    <p>{{ 'contact.form_intro'|trans }}</p>
                    {% include 'portfolio/_contact_form.html.twig' with {source: 'landing_about'} %}
                </div>
            </div>
            <nav class="contact-socials" aria-label="{{ 'contact.social_profiles'|trans }}">
                <span>{{ 'contact.social_profiles'|trans }}</span>
                <a href="https://github.com/bahdanhal" rel="me">GitHub ↗</a>
                <a href="https://www.instagram.com/bahdan.hal/" rel="me">Instagram ↗</a>
                <a href="https://www.facebook.com/profile.php?id=100008404566585" rel="me">Facebook ↗</a>
            </nav>
        </section>
    </article></div>
{% endblock %}
