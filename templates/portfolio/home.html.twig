{% extends 'base.html.twig' %}
{% block body_class %}portfolio-page about-page{% endblock %}
{% block title %}{{ 'about.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'about.meta.description'|trans }}">{% endblock %}
{% block canonical %}
    <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/' : 'https://bahdanhal.pl/' }}">
    <link rel="alternate" hreflang="en" href="https://bahdanhal.pl/">
    <link rel="alternate" hreflang="pl" href="https://bahdanhal.pl/pl/">
    <link rel="alternate" hreflang="x-default" href="https://bahdanhal.pl/">
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/portfolio.css"><link rel="stylesheet" href="/portfolio-services.css">{% endblock %}
{% block head_scripts %}
  <script type="application/ld+json">{{ {'@context':'https://schema.org','@graph':[{'@type':'Person','@id':'https://bahdanhal.pl/#bahdan','name':'Bahdan Hal','url':'https://bahdanhal.pl/','jobTitle':'Senior Backend & Systems Engineer','sameAs':['https://www.linkedin.com/in/bahdan-hal/','https://github.com/bahdanhal','https://www.instagram.com/bahdan.hal/','https://www.facebook.com/profile.php?id=100008404566585','https://www.upwork.com/freelancers/~014111a2d384da6af9']},{'@type':'WebApplication','@id':'https://stackhal.com/#app','name':'StackHal Developer Utilities Suite','url':'https://stackhal.com/','applicationCategory':'DeveloperApplication','operatingSystem':'All','author':{'@id':'https://bahdanhal.pl/#bahdan'}},{'@type':'WebApplication','@id':'https://ileza.pl/#app','name':'IleZa.pl Price Radar','url':'https://ileza.pl/','applicationCategory':'FinanceApplication','operatingSystem':'All','author':{'@id':'https://bahdanhal.pl/#bahdan'}}]}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body %}
    <article class="profile-shell">
        <section class="profile-hero">
            <div class="profile-hero-content">
                <div class="eyebrow">{{ 'about.eyebrow'|trans }}</div>
                <h1>{{ 'about.heading'|trans }} <span>{{ 'about.heading_emphasis'|trans }}</span></h1>
                <div class="profile-intro">
                    <p>{{ 'about.intro'|trans }}</p>
                    <div class="profile-actions">
                        <a class="profile-primary" href="{{ path('resume', {_locale: app.request.locale}) }}">{{ 'about.cta_resume'|trans }}</a>
                        <a class="profile-secondary" href="{{ path('services', {_locale: app.request.locale}) }}">{{ 'about.cta_services'|trans }}</a>
                        <a class="profile-tertiary" href="#contact">{{ 'about.cta_contact'|trans }} →</a>
                    </div>
                </div>
            </div>
            <div class="profile-hero-media">
                <img src="/images/profile/bahdan-portrait.jpg" alt="Bahdan Hal" width="480" height="560" class="profile-avatar">
            </div>
        </section>

        <section class="profile-facts" aria-label="{{ 'about.facts_label'|trans }}">
            <span>{{ 'about.location'|trans }}</span>
            <span>{{ 'about.stack_facts'|trans }}</span>
            <span>{{ 'about.infra_facts'|trans }}</span>
            <span>{{ 'about.experience_years'|trans }}</span>
        </section>

        <section class="about-story-section" id="story">
            <div class="profile-section-title">
                <span>{{ 'about.story.eyebrow'|trans }}</span>
                <h2>{{ 'about.story.title'|trans }}</h2>
            </div>
            <div class="about-story-content">
                <p class="story-lead">{{ 'about.story.p1'|trans }}</p>
                <p>{{ 'about.story.p2'|trans }}</p>
            </div>
        </section>

        <section class="profile-grid" id="principles">
            <div>
                <span class="profile-number">{{ 'about.philosophy.item1_number'|trans }}</span>
                <h2>{{ 'about.philosophy.item1_title'|trans }}</h2>
                <p>{{ 'about.philosophy.item1_text'|trans }}</p>
            </div>
            <div>
                <span class="profile-number">{{ 'about.philosophy.item2_number'|trans }}</span>
                <h2>{{ 'about.philosophy.item2_title'|trans }}</h2>
                <p>{{ 'about.philosophy.item2_text'|trans }}</p>
            </div>
            <div>
                <span class="profile-number">{{ 'about.philosophy.item3_number'|trans }}</span>
                <h2>{{ 'about.philosophy.item3_title'|trans }}</h2>
                <p>{{ 'about.philosophy.item3_text'|trans }}</p>
            </div>
        </section>

        <section class="profile-projects" id="projects" aria-labelledby="projects-title">
            <div class="profile-section-title">
                <span>{{ 'about.ecosystem.eyebrow'|trans }}</span>
                <h2 id="projects-title">{{ 'about.ecosystem.title'|trans }}</h2>
                <p>{{ 'about.ecosystem.intro'|trans }}</p>
            </div>
            <div class="profile-project-grid">
                <article class="profile-project-card">
                    <a href="https://ileza.pl/" target="_blank" rel="noopener" class="profile-project-image-link">
                        <img src="/images/projects/ileza-home.jpg" alt="{{ 'about.ecosystem.ileza.image_alt'|trans }}" loading="lazy" width="1280" height="720">
                    </a>
                    <div class="profile-project-content">
                        <div class="profile-project-meta"><span>IleZa.pl</span><span>{{ 'about.ecosystem.ileza.label'|trans }}</span></div>
                        <h3>{{ 'about.ecosystem.ileza.title'|trans }}</h3>
                        <p>{{ 'about.ecosystem.ileza.text'|trans }}</p>
                        <a href="https://ileza.pl/" target="_blank" rel="noopener" class="profile-project-link">{{ 'about.ecosystem.visit'|trans }} →</a>
                    </div>
                </article>
                <article class="profile-project-card">
                    <a href="https://stackhal.com/" target="_blank" rel="noopener" class="profile-project-image-link">
                        <img src="/images/projects/stackhal-home.jpg" alt="{{ 'about.ecosystem.stackhal.image_alt'|trans }}" loading="lazy" width="1280" height="720">
                    </a>
                    <div class="profile-project-content">
                        <div class="profile-project-meta"><span>StackHal</span><span>{{ 'about.ecosystem.stackhal.label'|trans }}</span></div>
                        <h3>{{ 'about.ecosystem.stackhal.title'|trans }}</h3>
                        <p>{{ 'about.ecosystem.stackhal.text'|trans }}</p>
                        <a href="https://stackhal.com/" target="_blank" rel="noopener" class="profile-project-link">{{ 'about.ecosystem.visit'|trans }} →</a>
                    </div>
                </article>
            </div>
        </section>

        <figure class="profile-summit-feature">
            <div class="summit-image-wrap">
                <img src="/images/profile/bahdan-summit.jpg" alt="{{ 'about.summit.alt'|trans }}" loading="lazy">
            </div>
            <figcaption>
                <span class="eyebrow">{{ 'about.summit.eyebrow'|trans }}</span>
                <h3>{{ 'about.summit.caption'|trans }}</h3>
                <p>{{ 'about.summit.subtext'|trans }}</p>
            </figcaption>
        </figure>

        <section class="about-gateways">
            <div class="profile-section-title">
                <span>{{ 'about.gateways.eyebrow'|trans }}</span>
                <h2>{{ 'about.gateways.title'|trans }}</h2>
            </div>
            <div class="gateway-grid">
                <article class="gateway-card">
                    <h3>{{ 'about.gateways.resume_title'|trans }}</h3>
                    <p>{{ 'about.gateways.resume_text'|trans }}</p>
                    <a href="{{ path('resume', {_locale: app.request.locale}) }}" class="gateway-cta">{{ 'about.gateways.resume_cta'|trans }}</a>
                </article>
                <article class="gateway-card gateway-card-highlight">
                    <h3>{{ 'about.gateways.services_title'|trans }}</h3>
                    <p>{{ 'about.gateways.services_text'|trans }}</p>
                    <a href="{{ path('services', {_locale: app.request.locale}) }}" class="gateway-cta">{{ 'about.gateways.services_cta'|trans }}</a>
                </article>
            </div>
        </section>

        <section class="profile-consultation" id="contact">
            <div>
                <span class="eyebrow">{{ 'about.contact_eyebrow'|trans }}</span>
                <h2>{{ 'about.contact_heading'|trans }}</h2>
                <p>{{ 'contact.note'|trans }}</p>
            </div>
            {% include 'portfolio/_contact_form.html.twig' with {source: 'landing_about'} %}
        </section>

        <section class="profile-contact">
            <div>
                <span class="eyebrow">{{ 'about.contact_eyebrow'|trans }}</span>
                <h2>{{ 'about.socials'|trans }}</h2>
            </div>
            <nav aria-label="{{ 'about.socials'|trans }}">
                <a href="mailto:bahdan.hal@hotmail.com">Email</a>
                <a href="https://www.linkedin.com/in/bahdan-hal/" rel="me">LinkedIn</a>
                <a href="https://github.com/bahdanhal" rel="me">GitHub</a>
                <a href="https://www.instagram.com/bahdan.hal/" rel="me">Instagram</a>
                <a href="https://www.facebook.com/profile.php?id=100008404566585" rel="me">Facebook</a>
                <a href="https://www.upwork.com/freelancers/~014111a2d384da6af9" rel="me">Upwork</a>
            </nav>
        </section>
    </article>
{% endblock %}
