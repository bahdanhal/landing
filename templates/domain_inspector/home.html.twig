{% extends 'base.html.twig' %}
{% block title %}{{ 'domain_inspector.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'domain_inspector.meta.description'|trans }}">{% endblock %}
{% block canonical %}
  <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/inspektor-domen' : 'https://bahdanhal.pl/tools/domain-inspector' }}">
  <link rel="alternate" hreflang="en" href="https://bahdanhal.pl/tools/domain-inspector">
  <link rel="alternate" hreflang="pl" href="https://bahdanhal.pl/pl/narzedzia/inspektor-domen">
  <link rel="alternate" hreflang="x-default" href="https://bahdanhal.pl/tools/domain-inspector">
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" href="/tools.css">
  <link rel="stylesheet" href="/domain-inspector.css">
{% endblock %}
{% block head_scripts %}
  <script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        '@id': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/inspektor-domen#app' : 'https://bahdanhal.pl/tools/domain-inspector#app'),
        'name': 'domain_inspector.heading'|trans,
        'description': 'domain_inspector.meta.description'|trans,
        'url': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/inspektor-domen' : 'https://bahdanhal.pl/tools/domain-inspector'),
        'applicationCategory': 'SecurityApplication',
        'operatingSystem': 'Any',
        'offers': {'@type': 'Offer', 'price': '0', 'priceCurrency': 'USD'},
        'author': {'@id': 'https://bahdanhal.pl/#bahdan'},
        'publisher': {'@id': 'https://bahdanhal.pl/#bahdan'}
      },
      {
        '@type': 'FAQPage',
        '@id': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/inspektor-domen#faq' : 'https://bahdanhal.pl/tools/domain-inspector#faq'),
        'inLanguage': app.request.locale,
        'mainEntity': [
          {'@type': 'Question', 'name': 'domain_inspector.faq.q1'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'domain_inspector.faq.a1'|trans}},
          {'@type': 'Question', 'name': 'domain_inspector.faq.q2'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'domain_inspector.faq.a2'|trans}},
          {'@type': 'Question', 'name': 'domain_inspector.faq.q3'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'domain_inspector.faq.a3'|trans}}
        ]
      }
    ]
  }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}
{% block language_switch %}
  <a class="language-switch" href="{{ path('domain_inspector_home', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
{% endblock %}
{% block tool_name %}{{ 'domain_inspector.title'|trans }}{% endblock %}

{% block body %}
<section class="tool-page-shell inspector-hero">
  {% include 'tools/_tool_intro.html.twig' with {
    eyebrow: 'domain_inspector.eyebrow'|trans,
    heading: 'domain_inspector.heading'|trans,
    lede: 'domain_inspector.lede'|trans
  } only %}

  <div class="inspector-shell">
    <div class="inspector-form-card ui-panel">
      <form action="{{ path('domain_inspector_check', {_locale: app.request.locale}) }}" method="POST">
        <label for="domain-input" class="ui-field-label">
          {{ 'domain_inspector.input_label'|trans }}
        </label>
        <div class="inspector-input-row">
          <input
            type="text"
            id="domain-input"
            name="domain"
            class="inspector-domain-input ui-input"
            placeholder="stripe.com"
            value="{{ domain|default('') }}"
            required
            autocomplete="off"
            autofocus
          >
          <button type="submit" class="btn-primary-action ui-button ui-button-primary">
            ⚡ {{ 'domain_inspector.check_btn'|trans }}
          </button>
        </div>

        <div class="inspector-example-pills">
          <span>{{ 'domain_inspector.examples_label'|trans }}:</span>
          <button type="button" class="example-domain-btn" onclick="document.getElementById('domain-input').value='stripe.com'">stripe.com</button>
          <button type="button" class="example-domain-btn" onclick="document.getElementById('domain-input').value='google.com'">google.com</button>
          <button type="button" class="example-domain-btn" onclick="document.getElementById('domain-input').value='github.com'">github.com</button>
          <button type="button" class="example-domain-btn" onclick="document.getElementById('domain-input').value='cloudflare.com'">cloudflare.com</button>
        </div>

        {% if error is defined and error is not empty %}
          <div class="ui-alert">
            ⚠️ {{ error }}
          </div>
        {% endif %}
      </form>
    </div>

    <!-- Feature Highlights -->
    <div class="ui-grid inspector-feature-grid">
      <div class="ui-panel inspector-feature-card">
        <h3>✅ {{ 'domain_inspector.features.dmarc.title'|trans }}</h3>
        <p class="ui-muted">
          {{ 'domain_inspector.features.dmarc.text'|trans }}
        </p>
      </div>

      <div class="ui-panel inspector-feature-card">
        <h3>🟣 {{ 'domain_inspector.features.bimi.title'|trans }}</h3>
        <p class="ui-muted">
          {{ 'domain_inspector.features.bimi.text'|trans }}
        </p>
      </div>

      <div class="ui-panel inspector-feature-card">
        <h3>🔒 {{ 'domain_inspector.features.mta_sts.title'|trans }}</h3>
        <p class="ui-muted">
          {{ 'domain_inspector.features.mta_sts.text'|trans }}
        </p>
      </div>

      <div class="ui-panel inspector-feature-card">
        <h3>📊 {{ 'domain_inspector.features.tls_rpt.title'|trans }}</h3>
        <p class="ui-muted">
          {{ 'domain_inspector.features.tls_rpt.text'|trans }}
        </p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="tool-faq ui-panel" style="margin-top: 1.5rem; padding: 1.5rem; background: var(--surface, #1e2430); border: 1px solid var(--border, #2d3748); border-radius: 8px;">
      <h3 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.15rem; color: #f8fafc;">{{ 'domain_inspector.faq.title'|trans }}</h3>
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        {% for idx in ['q1', 'q2', 'q3'] %}
          <details style="background: rgba(0,0,0,0.2); border: 1px solid var(--border, #334155); border-radius: 6px; padding: 0.85rem 1.1rem;" {% if loop.first %}open{% endif %}>
            <summary style="font-size: 0.95rem; color: #f8fafc; cursor: pointer;"><strong>{{ ('domain_inspector.faq.' ~ idx)|trans }}</strong></summary>
            <div style="margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px solid rgba(255,255,255,0.08);">
              <p style="margin: 0; font-size: 0.88rem; line-height: 1.55; color: #cbd5e1;">{{ ('domain_inspector.faq.a' ~ loop.index)|trans }}</p>
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
