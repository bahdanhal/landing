{% set tool_context %}{% block tool_name %}{% endblock %}{% endset %}
<!doctype html>
<html lang="{{ app.request ? app.request.getLocale() : 'pl' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta property="og:site_name" content="IleZa.pl">
  <meta property="og:type" content="website">
  {% block robots %}<meta name="robots" content="index,follow">{% endblock %}
  {% block description %}{% endblock %}
  {% block canonical %}{% endblock %}
  <title>{% block title %}{{ 'base.default_title'|trans }}{% endblock %}</title>
  {% block opengraph %}
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:locale" content="{{ app.request ? (app.request.locale == 'pl' ? 'pl_PL' : 'en_US') : 'pl_PL' }}">
    <meta property="og:locale:alternate" content="{{ app.request ? (app.request.locale == 'pl' ? 'en_US' : 'pl_PL') : 'en_US' }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title')|striptags|trim }}">
  {% endblock %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg">
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/toolbox.css">
  <link rel="stylesheet" href="/grouped-findings.css">
  <link rel="stylesheet" href="/contact.css">
  <link rel="stylesheet" href="/identity.css">
  <link rel="stylesheet" href="/ui.css">
  {% block stylesheets %}{% endblock %}
  <link rel="stylesheet" href="/theme-dark.css">
  <script src="/contact.js" defer></script>
  <script type="application/ld+json">{{ {'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':'https://ileza.pl/#website','url':'https://ileza.pl/','name':'IleZa.pl','inLanguage':['pl','en'],'publisher':{'@id':'https://bahdanhal.pl/#bahdan'},'author':{'@id':'https://bahdanhal.pl/#bahdan'},'dateModified':'2026-08-22'}]}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
  {% block head_scripts %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
  <header class="site-header">
    <div class="topbar">
      <div class="brand-lockup">
        {% block brand_lockup %}
        <a class="brand" href="{{ path('market_home', {_locale: app.request.locale}) }}" aria-label="IleZa.pl">
          <span class="brand-mark">↗</span>
          <span class="brand-name"><span class="brand-name-full">IleZa.pl</span><span class="brand-name-short">IleZa</span></span>
        </a>
        <a class="brand-credit" href="https://bahdanhal.pl/">{{ 'base.by'|trans }}</a>
        {% endblock %}
      </div>
      <div class="topbar-actions">
        <nav class="primary-nav" aria-label="{{ 'base.navigation'|trans }}">
          <a href="{{ path('market_home', {_locale: app.request.locale}) }}">{{ 'base.nav.market'|trans }}</a>
          <a href="{{ path('income_calculator', {_locale: app.request.locale}) }}">{{ 'base.nav.income'|trans }}</a>
        </nav>
        {% block language_switch %}
          <a class="language-switch" href="{{ path('market_home', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>
        {% endblock %}
      </div>
    </div>
    {% if tool_context|trim is not empty %}
      <div class="tool-context-bar">
        <a href="{{ path('market_home', {_locale: app.request.locale}) }}">{{ 'base.nav.market'|trans }}</a>
        <span aria-hidden="true">/</span>
        <strong>{{ tool_context|trim }}</strong>
      </div>
    {% endif %}
  </header>
  <main>{% block body %}{% endblock %}</main>
  <footer>{{ 'base.footer'|trans }} · <a class="footer-contact" href="mailto:bahdan.hal@hotmail.com">{{ 'base.contact'|trans }}</a><br><span class="copyright">© {{ "now"|date("Y") }} Bahdan Hal</span></footer>
  {% block scripts %}{% endblock %}
</body>
</html>
