{% extends 'base.html.twig' %}
{% block tool_name %}{{ 'base.context.income'|trans }}{% endblock %}
{% block title %}{{ 'income.meta.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="index,follow">{% endblock %}
{% block description %}<meta name="description" content="{{ 'income.meta.description'|trans }}">{% endblock %}
{% block canonical %}
  <link rel="canonical" href="{{ app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/kalkulator-wynagrodzen' : 'https://bahdanhal.pl/tools/poland-employment-calculator' }}">
  <link rel="alternate" hreflang="en" href="https://bahdanhal.pl/tools/poland-employment-calculator"><link rel="alternate" hreflang="pl" href="https://bahdanhal.pl/pl/narzedzia/kalkulator-wynagrodzen"><link rel="alternate" hreflang="x-default" href="https://bahdanhal.pl/tools/poland-employment-calculator">
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/tools.css"><link rel="stylesheet" href="/income.css">{% endblock %}
{% block head_scripts %}
  <script type="application/ld+json">{{ {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebApplication',
        '@id': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/kalkulator-wynagrodzen#app' : 'https://bahdanhal.pl/tools/poland-employment-calculator#app'),
        'name': 'income.heading'|trans,
        'description': 'income.meta.description'|trans,
        'url': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/kalkulator-wynagrodzen' : 'https://bahdanhal.pl/tools/poland-employment-calculator'),
        'applicationCategory': 'FinanceApplication',
        'operatingSystem': 'Any',
        'offers': {'@type': 'Offer', 'price': '0', 'priceCurrency': 'USD'},
        'author': {'@id': 'https://bahdanhal.pl/#bahdan'},
        'publisher': {'@id': 'https://bahdanhal.pl/#bahdan'}
      },
      {
        '@type': 'FAQPage',
        '@id': (app.request.locale == 'pl' ? 'https://bahdanhal.pl/pl/narzedzia/kalkulator-wynagrodzen#faq' : 'https://bahdanhal.pl/tools/poland-employment-calculator#faq'),
        'inLanguage': app.request.locale,
        'mainEntity': [
          {'@type': 'Question', 'name': 'income.faq.q1'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'income.faq.a1'|trans}},
          {'@type': 'Question', 'name': 'income.faq.q2'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'income.faq.a2'|trans}},
          {'@type': 'Question', 'name': 'income.faq.q3'|trans, 'acceptedAnswer': {'@type': 'Answer', 'text': 'income.faq.a3'|trans}}
        ]
      }
    ]
  }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}
{% block language_switch %}<a class="language-switch" href="{{ path('income_calculator', {_locale: app.request.locale == 'pl' ? 'en' : 'pl'}) }}" hreflang="{{ app.request.locale == 'pl' ? 'en' : 'pl' }}">{{ app.request.locale == 'pl' ? 'EN' : 'PL' }}</a>{% endblock %}
{% block body %}
<section class="tool-shell income-shell">
  {% include 'tools/_tool_intro.html.twig' with {
    eyebrow: 'income.eyebrow'|trans,
    heading: 'income.heading'|trans,
    lede: 'income.lede'|trans,
    badge_label: 'income.verified'|trans,
    badge_value: verified_at|date(app.request.locale == 'pl' ? 'd.m.Y' : 'M j, Y')
  } only %}
  <div class="income-calculator" data-income-calculator data-locale="{{ app.request.locale }}" data-labels="{{ {employment:'income.types.employment'|trans,mandate:'income.types.mandate'|trans,work:'income.types.work'|trans,b2b:'income.types.b2b'|trans,net:'income.result.net'|trans,budget:'income.result.budget'|trans,gross:'income.result.gross'|trans,costs:'income.result.costs'|trans,social:'income.result.social'|trans,health:'income.result.health'|trans,tax:'income.result.tax'|trans}|json_encode }}">
    <div class="income-controls">
      <div class="field"><label for="income-budget">{{ 'income.form.budget'|trans }}</label><div class="money-input"><input id="income-budget" data-control="budget" inputmode="decimal" value="12000"><span>PLN</span></div><small>{{ 'income.form.budget_help'|trans }}</small></div>
      <label class="check-field"><input type="checkbox" data-control="student"> <span>{{ 'income.form.student'|trans }}</span></label>
      <div class="field"><label for="income-costs">{{ 'income.form.costs'|trans }}</label><div class="money-input"><input id="income-costs" data-control="costs" inputmode="decimal" value="500"><span>PLN</span></div></div>
      <div class="field"><label for="income-taxation">{{ 'income.form.taxation'|trans }}</label><select id="income-taxation" data-control="taxation"><option value="linear">{{ 'income.taxation.linear'|trans }}</option><option value="scale">{{ 'income.taxation.scale'|trans }}</option><option value="lump">{{ 'income.taxation.lump'|trans }}</option></select></div>
      <div class="field"><label for="income-zus">{{ 'income.form.zus'|trans }}</label><select id="income-zus" data-control="zus"><option value="standard">{{ 'income.zus.standard'|trans }}</option><option value="preferential">{{ 'income.zus.preferential'|trans }}</option><option value="start">{{ 'income.zus.start'|trans }}</option></select></div>
      <div class="field" hidden><label for="income-lump-rate">{{ 'income.form.lump_rate'|trans }}</label><div class="percent-input"><input id="income-lump-rate" data-control="lumpRate" type="number" min="0" max="17" step="0.5" value="12"><span>%</span></div></div>
    </div>
    <div class="income-results" data-results aria-live="polite"></div>
  </div>
  <aside class="income-assumptions"><h2>{{ 'income.assumptions.title'|trans }}</h2><p>{{ 'income.assumptions.text'|trans }}</p><ul><li>{{ 'income.assumptions.one'|trans }}</li><li>{{ 'income.assumptions.two'|trans }}</li><li>{{ 'income.assumptions.three'|trans }}</li></ul></aside>
  <div class="content-grid"><section class="content-card"><h2>{{ 'income.sources.title'|trans }}</h2><p>{{ 'income.sources.text'|trans }}</p><ul><li><a href="https://www.podatki.gov.pl/podatki-osobiste/pit/informacje-podstawowe/co-jest-opodatkowane/dochody-z-pracy" target="_blank" rel="noopener noreferrer">podatki.gov.pl — PIT 2026</a></li><li><a href="https://www.zus.pl/firmy/rozliczenia-z-zus/skladki-na-ubezpieczenia/zdrowotne" target="_blank" rel="noopener noreferrer">ZUS — {{ 'income.sources.health'|trans }}</a></li><li><a href="https://biznes.gov.pl/pl/portal/001052" target="_blank" rel="noopener noreferrer">Biznes.gov.pl — {{ 'income.sources.business'|trans }}</a></li></ul></section><section class="content-card proposal-card"><h2>{{ 'income.limitations.title'|trans }}</h2><p>{{ 'income.limitations.text'|trans }}</p><strong>{{ 'income.disclaimer'|trans }}</strong></section></div>

  <!-- FAQ Section -->
  <div class="tool-faq" style="margin-top: 3rem; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 24px;">
    <h2>{{ 'income.faq.title'|trans }}</h2>
    {% for idx in ['q1', 'q2', 'q3'] %}
      <details style="border-top: 1px solid var(--line); padding: 14px 0;" {% if loop.first %}open{% endif %}>
        <summary style="font-weight: 800; cursor: pointer;">{{ ('income.faq.' ~ idx)|trans }}</summary>
        <p style="margin-top: 8px; color: var(--muted); line-height: 1.6;">{{ ('income.faq.a' ~ loop.index)|trans }}</p>
      </details>
    {% endfor %}
  </div>
</section>
{% endblock %}
{% block scripts %}<script src="/income-math.js"></script><script src="/income-calculator.js"></script>{% endblock %}
