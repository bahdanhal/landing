{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain Security & Deliverability Inspector Specification",
  "description": "Rules and evaluation criteria for DMARC, BIMI, MTA-STS, SMTP TLS-RPT, SPF and MX checks.",
  "version": "1.0.0",
  "protocols": [
    {
      "name": "dmarc",
      "rfc": "RFC 7489",
      "dns_prefix": "_dmarc",
      "record_type": "TXT",
      "bimi_qualifying_policies": ["quarantine", "reject"],
      "bimi_min_quarantine_pct": 100
    },
    {
      "name": "bimi",
      "rfc": "BIMI Group Specification / RFC Draft",
      "dns_prefix": "default._bimi",
      "record_type": "TXT",
      "required_tags": ["v", "l"],
      "expected_version": "BIMI1",
      "svg_profile": "SVG Tiny 1.2 PS"
    },
    {
      "name": "mta_sts",
      "rfc": "RFC 8461",
      "dns_prefix": "_mta-sts",
      "record_type": "TXT",
      "policy_url_path": "/.well-known/mta-sts.txt",
      "policy_modes": ["enforce", "testing", "none"]
    },
    {
      "name": "tls_rpt",
      "rfc": "RFC 8460",
      "dns_prefix": "_smtp._tls",
      "record_type": "TXT",
      "expected_version": "TLSRPTv1"
    },
    {
      "name": "spf",
      "rfc": "RFC 7208",
      "record_type": "TXT",
      "expected_prefix": "v=spf1"
    }
  ],
  "scoring": {
    "max_score": 100,
    "weights": {
      "dmarc": 35,
      "bimi": 20,
      "mta_sts": 20,
      "tls_rpt": 10,
      "spf": 10,
      "mx": 5
    }
  }
}
