<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.2/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites><testsuite name="SEO"><directory>tests</directory></testsuite></testsuites>
  <php><env name="APP_ENV" value="test"/><env name="APP_SECRET" value="test-secret"/></php>
</phpunit>
