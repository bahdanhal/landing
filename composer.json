{
  "name": "bahdanhal/bahdan-landing",
  "description": "Bilingual practical toolbox with VAT, GEO, SEO and Polish second-hand market history",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "symfony/asset": "8.1.*",
    "symfony/cache": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2.7",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/yaml": "8.1.*",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/phpunit-bridge": "8.1.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {
    "allow-plugins": {"symfony/flex": true, "symfony/runtime": true},
    "sort-packages": true
  },
  "scripts": {
    "auto-scripts": {"cache:clear": "symfony-cmd"},
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  },
  "extra": {"symfony": {"allow-contrib": false, "require": "8.1.*"}}
}
