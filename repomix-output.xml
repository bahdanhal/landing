    crawlers:
        title: "Published AI crawler controls"
        not_scored: "Policy visibility · not scored"
        intro: "This is a simplified reading of robots.txt for named agents. Training, search retrieval and user-triggered browsing can use different controls."
        blocked: "Blocked at /"
        allowed: "Explicitly allowed"
        not-addressed: "No specific rule"
        present: "Present"
        absent: "Not found"
        caveat: "llms.txt is an experimental convention, not an official requirement of major answer engines. A robots.txt permission does not mean a service will crawl or cite the page, and blocking a training crawler may be an intentional choice."
